# =============================================================
# backend.env.j2 — Backend Environment Variables Template
# Ansible fills in {{ variables }} from the vars files.
# This file ends up at /opt/travelmemory/backend/.env on the server.
# =============================================================

# MongoDB connection string
# Format: mongodb://username:password@host:port/database
MONGO_URL=mongodb://{{ mongodb_app_user }}:{{ mongodb_app_password }}@{{ db_private_ip }}:27017/{{ mongodb_app_database }}

# Port for the Express backend to listen on
PORT=3001

# Environment type — affects error messages and logging
NODE_ENV=production
