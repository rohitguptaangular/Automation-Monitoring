# =============================================================
# frontend.env.j2 — React Frontend Environment Variables Template
# This file ends up at /opt/travelmemory/frontend/.env
# React reads these during the BUILD step (npm run build).
# =============================================================

# URL where the Express backend API is running
# The React app sends fetch/axios requests to this URL.
# This is the PUBLIC IP of the web server since the browser
# (running on a user's laptop) needs to reach it.
VITE_BACKEND_URL=http://{{ web_public_ip }}:3001
